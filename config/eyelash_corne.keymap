#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      
    time-to-max-speed-ms = <100>;       
    delay-ms = <0>;                   
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        // Miryoku Home Row Mod Hold-Tap settings
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";
        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// LAYER 0: BASE (WORKMAN ALPHAS + HOME ROW MODS)
        default_layer {
            display-name = "WORKMAN";
            bindings = <
&kp TAB    &kp Q        &kp W        &kp E       &kp R       &kp T                                                 &kp UP                &kp J       &kp F        &kp U       &kp P        &kp SEMI    &kp BSPC
&td0       &hm LGUI A   &hm LALT S   &hm LCTRL T &hm LSHFT H &kp G                                       &kp LEFT  &kp ENTER  &kp RIGHT  &kp Y       &hm RSHFT N  &hm RCTRL E &hm LALT O   &hm RGUI I  &kp SQT
&kp LCTRL  &kp Z        &kp X        &kp M       &kp C       &kp V       &kp SPACE                         &kp DOWN                        &kp K       &kp L        &kp COMMA   &kp DOT      &kp FSLH    &kp ESC
                                     &mo 3       &mo 1       &mo 2                                                                       &mo 5       &mo 4        &mo 6
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // LAYER 1: NAV
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans                                                &mmv MOVE_UP                    &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO &kp BSPC
&trans  &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &trans                                  &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT     &kp LEFT   &kp DOWN    &kp UP     &kp RIGHT &trans     &trans
&trans  &trans    &trans    &trans    &trans    &trans    &trans                              &mmv MOVE_DOWN                        &kp HOME   &kp PG_DN   &kp PG_UP  &kp END   &trans     &trans
                            &trans    &trans    &trans                                                                                &kp RET    &kp BSPC    &kp DEL
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // LAYER 2: MOUSE
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans                                                &mmv MOVE_UP                    &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO &kp BSPC
&trans  &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &trans                                  &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans &trans
&trans  &trans    &trans    &trans    &trans    &trans    &trans                              &mmv MOVE_DOWN                        &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &trans &trans
                            &trans    &trans    &trans                                                                                &mkp RCLK  &mkp LCLK   &mkp MCLK
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // LAYER 3: MEDIA
        media_layer {
            display-name = "MEDIA";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans                                                &mmv MOVE_UP                    &trans     &trans       &trans       &trans     &trans     &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &trans                                  &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT     &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &trans     &trans
&trans  &trans    &trans    &trans    &trans    &trans    &trans                              &mmv MOVE_DOWN                        &trans     &trans       &trans       &trans     &trans     &trans
                            &trans    &trans    &trans                                                                                &kp C_STOP &kp C_PP     &kp C_MUTE
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // LAYER 4: NUM
        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp LBKT  &kp N7    &kp N8    &kp N9    &kp RBKT                                              &mmv MOVE_UP                    &trans     &trans    &trans    &trans    &trans    &kp BSPC
&trans  &kp SEMI  &kp N4    &kp N5    &kp N6    &kp EQUAL                               &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT     &trans     &kp RSHFT &kp RCTRL &kp LALT  &kp RGUI  &trans
&trans  &kp GRAVE &kp N1    &kp N2    &kp N3    &kp BSLH  &trans                              &mmv MOVE_DOWN                        &trans     &trans    &trans    &trans    &trans    &trans
                            &kp DOT   &kp N0    &kp MINUS                                                                             &trans     &trans    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // LAYER 5: SYM
        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp LBRC  &kp AMPS  &kp ASTRK &kp LPAR  &kp RBRC                                              &mmv MOVE_UP                    &trans     &trans    &trans    &trans    &trans    &kp BSPC
&trans  &kp COLON &kp DLLR  &kp PRCNT &kp CARET &kp PLUS                                &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT     &trans     &kp RSHFT &kp RCTRL &kp LALT  &kp RGUI  &trans
&trans  &kp TILDE &kp EXCL  &kp AT    &kp HASH  &kp PIPE  &trans                              &mmv MOVE_DOWN                        &trans     &trans    &trans    &trans    &trans    &trans
                            &kp LPAR  &kp RPAR  &kp UNDER                                                                             &trans     &trans    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // LAYER 6: FUN
        fun_layer {
            display-name = "FUN";
            bindings = <
&trans          &kp F12     &kp F7    &kp F8    &kp F9    &kp PSCRN                                             &mmv MOVE_UP                    &trans     &trans    &trans    &trans    &trans    &trans
&trans          &kp F11     &kp F4    &kp F5    &kp F6    &kp SLCK                                &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT     &trans     &kp RSHFT &kp RCTRL &kp LALT  &kp RGUI  &trans
&studio_unlock  &kp F10     &kp F1    &kp F2    &kp F3    &kp PAUSE_BREAK &trans                  &mmv MOVE_DOWN                        &trans     &trans    &trans    &trans    &trans    &trans
                                      &kp K_APP &kp SPACE &kp TAB                                                                             &trans     &trans    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
