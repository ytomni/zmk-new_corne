#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift / Caps Word";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        // Guarded layer-tap for the thumb keys. The stock &lt has no
        // quick-tap and no prior-idle guard, so a thumb held a few ms too
        // long mid-word silently swaps in a whole layer under your fingers.

        ltq: layer_tap_guarded {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Left-hand HRM. Fires only when the next key is on the right half
        // (or in the middle cluster). Prevents same-hand misfires while typing.

        hml: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                6  7  8  9 10 11 12
               19 20 21 22 23 24 25 26 27
               34 35 36 37 38 39 40 41
               45 46 47
            >;

            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Right-hand HRM. Mirror of hml; fires only when the next key is
        // on the left half (or in the middle cluster).

        hmr: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                0  1  2  3  4  5  6
               13 14 15 16 17 18 19 20 21
               28 29 30 31 32 33 34 35
               42 43 44
            >;

            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        // --- dwm shift-chord macros -----------------------------------------

        m_lock: m_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp L>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_scrsel: m_scrsel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_scrwin: m_scrwin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp W>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_full: m_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_zoom: m_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp RET>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_bar: m_bar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp B>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_kill: m_kill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_quit: m_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };

        m_term: m_term {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp RET>,
                <&macro_release>,
                <&kp LGUI>;

            wait-ms = <10>;
            tap-ms = <10>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        // ---- safety / power -----------------------------------------------

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
            timeout-ms = <50>;
        };

        // ---- typing helpers -----------------------------------------------

        capsword {
            bindings = <&caps_word>;
            key-positions = <17 23>;        // T + N (both index home)
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // ---- Vicinae ------------------------------------------------------

        vicinae_toggle {
            bindings = <&kp LG(SEMI)>;
            key-positions = <14 26>;        // A + I (both pinky home)
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // ---- dwm shortcuts via combo --------------------------------------

        dwm_togglebar {
            bindings = <&m_bar>;
            key-positions = <15 25>;        // S + O (both ring home)
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        dwm_killwin {
            bindings = <&m_kill>;
            key-positions = <29 40>;        // Z + /
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        dwm_fullscr {
            bindings = <&m_full>;
            key-positions = <43 46>;        // both inner thumbs
            timeout-ms = <50>;
        };

        // ---- bluetooth ----------------------------------------------------

        // Nuclear: forgets every host bond. Deliberately a two-key chord at
        // opposite ends of the BT row, and only while the MEDIA layer is
        // held, so no stray thumb can ever reach it again.

        bt_clr_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <36 41>;        // BT_SEL 0 + BT_CLR
            layers = <4>;
            timeout-ms = <50>;
        };

        // ---- TAGS layer ---------------------------------------------------

        tags_layer_hold {
            bindings = <&mo 3>;
            key-positions = <18 22>;        // G + Y (both index outer)
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ===================================================================
        // LAYER 0: BASE (Workman alphas + bilateral HRM, no GUI on home row)
        // ===================================================================

        base {
            display-name = "WORKMAN";
            bindings = <
&kp LCTRL  &kp Q  &kp D        &kp R         &kp W         &kp B                               &kp UP                &kp J        &kp F            &kp U         &kp P        &kp SEMI  &kp TAB
&kp LWIN   &kp A  &hml LALT S  &hml LCTRL H  &hml LSHFT T  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp Y        &hmr RSHFT N     &hmr RCTRL E  &hmr RALT O  &kp I     &kp SQT
&kp LSHFT  &kp Z  &kp X        &kp M         &kp C         &kp V        &kp SPACE              &kp DOWN              &kp K        &kp L            &kp COMMA     &kp DOT      &kp FSLH  &kp LCTRL
                               &ltq 4 ESC    &ltq 1 TAB    &ltq 2 SPACE                                              &ltq 6 ENTER  &ltq 5 BACKSPACE  &ltq 7 DELETE
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 1: NAV
        // ===================================================================

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans                            &mmv MOVE_UP                     &kp K_REDO  &kp K_PASTE     &kp K_COPY     &kp K_CUT     &kp K_UNDO  &kp BSPC
&trans  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &trans            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp CAPS    &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW  &kp RIGHT   &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans                    &mmv MOVE_DOWN                   &kp INSERT  &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &trans
                            &trans     &trans     &trans                                                             &kp RET     &kp BSPC        &kp DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 2: MOUSE
        // ===================================================================

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&tog 8  &trans    &trans    &trans     &trans     &trans                            &mmv MOVE_UP                     &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &kp BSPC
&trans  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &trans            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans                    &mmv MOVE_DOWN                   &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                            &trans     &trans     &trans                                                             &mkp RCLK   &mkp LCLK       &mkp MCLK
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 3: TAGS  (reached via G+Y combo, momentary &mo 3)
        // top row    = Super+N         (view tag N)
        // home row   = Super+Shift+N   (move active window to tag N)
        // bottom row = Super+Ctrl+N    (toggle view of tag N)
        // ===================================================================

        tags_layer {
            display-name = "TAGS";
            bindings = <
&trans  &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)                        &trans           &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(N0)      &trans
&trans  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))            &trans  &m_zoom  &trans  &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))  &kp LG(LS(N0))  &trans
&trans  &kp LG(LC(N1))  &kp LG(LC(N2))  &kp LG(LC(N3))  &kp LG(LC(N4))  &kp LG(LC(N5))  &trans            &trans           &kp LG(LC(N6))  &kp LG(LC(N7))  &kp LG(LC(N8))  &kp LG(LC(N9))  &kp LG(LC(N0))  &trans
                                        &trans          &trans          &trans                                             &trans          &trans          &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 4: MEDIA
        //   bottom row  = BT profile 0..4, then BT_CLR (drop this profile)
        //   top right   = OUT_TOG   (flip USB <-> BLE)
        //   row 1 outer = OUT_BLE   (force wireless -- USB recovery escape)
        //   BT_CLR_ALL is the <36 41> chord on this layer, nothing else.
        // ===================================================================

        media_layer {
            display-name = "MEDIA";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans                            &mmv MOVE_UP                     &rgb_ug RGB_TOG  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF    &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &out OUT_TOG
&trans  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &trans            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &out OUT_BLE     &kp C_PREV       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT       &kp K_MUTE
&trans  &trans    &trans    &trans     &trans     &trans  &trans                    &mmv MOVE_DOWN                   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_CLR
                            &trans     &trans     &trans                                                             &kp C_STOP       &kp C_PP         &kp C_MUTE
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 5: NUM
        // ===================================================================

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT                                 &mmv MOVE_UP                     &trans  &trans     &trans     &trans    &trans    &kp BSPC
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH   &kp K_MUTE                    &mmv MOVE_DOWN                   &trans  &trans     &trans     &trans    &trans    &trans
                           &kp DOT  &kp N0  &kp MINUS                                                                 &trans  &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 6: SYM
        // ===================================================================

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC                             &mmv MOVE_UP                     &trans  &trans     &trans     &trans    &trans    &kp BSPC
&trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &trans
&trans  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE   &trans                    &mmv MOVE_DOWN                   &trans  &trans     &trans     &trans    &trans    &trans
                             &kp LPAR   &kp RPAR   &kp UNDER                                                             &trans  &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 7: FUN  (F-keys on the left, dwm WM cluster on the right)
        //   right top:  LOCK | SCR-SEL | SCR-WIN | FULL | ZOOM
        //   right mid:  TERM | passthrough mods
        //   right bot:  BAR  | KILL    | QUIT
        // ===================================================================

        fun_layer {
            display-name = "FUN";
            bindings = <
&trans          &kp F12  &kp F7  &kp F8     &kp F9   &kp PSCRN                                  &mmv MOVE_UP                     &m_lock  &m_scrsel  &m_scrwin  &m_full   &m_zoom   &trans
&trans          &kp F11  &kp F4  &kp F5     &kp F6   &kp SLCK                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &m_term  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI  &trans
&studio_unlock  &kp F10  &kp F1  &kp F2     &kp F3   &kp PAUSE_BREAK  &trans                    &mmv MOVE_DOWN                   &m_bar   &m_kill    &m_quit    &trans    &trans    &trans
                                 &kp K_APP  &kp TAB  &kp SPACE                                                                   &trans   &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };

        // ===================================================================
        // LAYER 8: MC (Minecraft / game layer — toggled via &tog 8)
        // ===================================================================

        mc {
            display-name = "GAME";
            bindings = <
&kp ESC    &kp T   &kp Q   &kp W    &kp E       &kp N1                       &trans          &trans  &trans  &trans  &trans  &trans  &trans
&tog 8     &kp F   &kp A   &kp S    &kp D       &kp N2               &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp F1  &kp F2  &kp F3   &kp F4      &kp N3     &tog 8            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                           &kp ESC  &kp LSHIFT  &kp SPACE                                    &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_scroll>;
        };
    };
};
